# Credenciales de Supabase (Project Settings > API)
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_KEY=tu-service-role-key

# Clave secreta para firmar los JWT que emite Flask
JWT_SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
JWT_ACCESS_TOKEN_EXPIRES_MIN=60

# Dominio del frontend permitido por CORS
FRONTEND_ORIGIN=http://localhost:5173
